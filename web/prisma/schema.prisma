// Uklidno – datový model
//
// Pozn. k enumům: schéma běží na SQLite (rychlý lokální vývoj) i na PostgreSQL
// (produkce). SQLite v Prisma nepodporuje `enum` ani skalární pole typu pole,
// proto jsou "enumy" ukládány jako String a jejich povolené hodnoty žijí
// v src/lib/constants.ts (jediný zdroj pravdy + české popisky).
// Přechod na Postgres = změna `provider` níže, schéma zůstává kompatibilní.
//
// Peníze: všechny částky jsou celá čísla v haléřích (99 Kč = 9900).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- účty / auth

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String // CLIENT | CLEANER | ADMIN
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("cs")
  status       String    @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  clientProfile  ClientProfile?
  cleanerProfile CleanerProfile?

  payments      Payment[]
  subscriptions Subscription[]
  paymentMethods PaymentMethod[]
  notifications Notification[]

  reviewsWritten Review[] @relation("ReviewAuthor")
  reviewsGot     Review[] @relation("ReviewTarget")
  messages       Message[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ------------------------------------------------------------------- profily

model ClientProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  street     String?
  city       String?
  postalCode String?
  /// typ domácnosti: HOUSE | APARTMENT | OFFICE
  placeType  String?
  areaM2     Int?
  hasPets    Boolean @default(false)
  note       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CleanerProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  headline        String?
  bio             String?
  city            String
  postalCode      String?
  radiusKm        Int     @default(15)
  yearsExperience Int     @default(0)
  /// hodinová sazba v haléřích
  hourlyRate      Int     @default(30000)
  hasOwnSupplies  Boolean @default(false)
  hasCar          Boolean @default(false)
  invoices        Boolean @default(false) // fakturuje / IČO
  criminalRecordChecked Boolean @default(false)
  verified        Boolean @default(false)
  /// PENDING | APPROVED | REJECTED – ruční ověření profilu
  verificationState String @default("PENDING")
  ratingAvg       Float   @default(0)
  ratingCount     Int     @default(0)
  completedJobs   Int     @default(0)
  acceptingWork   Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  services  CleanerService[]
  languages CleanerLanguage[]
  availability Availability[]
  availabilityExceptions AvailabilityException[]

  @@index([city])
  @@index([ratingAvg])
}

model CleanerService {
  id        String @id @default(cuid())
  cleanerId String
  /// HOME_CLEANING | OFFICE_CLEANING | IRONING | WINDOWS | DEEP_CLEANING | LAUNDRY | POST_RENOVATION
  service   String

  cleaner CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, service])
  @@index([service])
}

model CleanerLanguage {
  id        String @id @default(cuid())
  cleanerId String
  /// cs | sk | en | de | uk | vi | ru
  language  String
  /// BASIC | INTERMEDIATE | FLUENT | NATIVE
  level     String @default("INTERMEDIATE")

  cleaner CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, language])
  @@index([language])
}

// ------------------------------------------------------------------ kalendář

/// Opakující se týdenní dostupnost. Časy jsou minuty od půlnoci (8:00 = 480).
model Availability {
  id        String @id @default(cuid())
  cleanerId String
  weekday   Int // 1 = pondělí … 7 = neděle
  startMin  Int
  endMin    Int

  cleaner CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId, weekday])
}

/// Výjimka pro konkrétní den – dovolená (blocked) nebo mimořádná směna.
model AvailabilityException {
  id        String   @id @default(cuid())
  cleanerId String
  date      DateTime
  blocked   Boolean  @default(true)
  startMin  Int?
  endMin    Int?
  note      String?

  cleaner CleanerProfile @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId, date])
}

// ------------------------------------------------------- poptávky a nabídky

model JobRequest {
  id          String   @id @default(cuid())
  clientId    String // User.id (role CLIENT)
  title       String
  description String
  city        String
  postalCode  String?
  street      String? // zobrazí se až po propojení
  areaM2      Int?
  /// ONE_TIME | WEEKLY | BIWEEKLY | MONTHLY
  frequency   String   @default("ONE_TIME")
  estimatedHours Int?
  /// rozpočet za hodinu v haléřích
  budgetPerHour Int?
  preferredFrom DateTime?
  preferredTo   DateTime?
  note          String?
  /// OPEN | MATCHED | CANCELLED | EXPIRED
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services JobRequestService[]
  offers   Offer[]
  match    Match?

  @@index([status, city])
  @@index([clientId])
}

model JobRequestService {
  id           String @id @default(cuid())
  jobRequestId String
  service      String

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([jobRequestId, service])
}

model Offer {
  id           String   @id @default(cuid())
  jobRequestId String
  cleanerId    String // CleanerProfile.id
  message      String
  /// nabídnutá hodinová sazba v haléřích
  pricePerHour Int
  availableFrom DateTime?
  /// PENDING | ACCEPTED | REJECTED | WITHDRAWN
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@unique([jobRequestId, cleanerId])
  @@index([cleanerId, status])
}

/// Propojení klient ↔ uklízečka. Vzniká po přijetí nabídky a zaplacení
/// zprostředkovatelského poplatku. Teprve od této chvíle vidí strany kontakt.
model Match {
  id           String   @id @default(cuid())
  jobRequestId String   @unique
  clientId     String
  cleanerId    String // CleanerProfile.id
  offerId      String   @unique
  /// PENDING_PAYMENT | ACTIVE | CLOSED
  status       String   @default("PENDING_PAYMENT")
  contactUnlockedAt DateTime?
  createdAt    DateTime @default(now())

  jobRequest   JobRequest    @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  conversation Conversation?
  bookings     Booking[]
  payments     Payment[]

  @@index([clientId])
  @@index([cleanerId])
}

// ------------------------------------------------------------------ rezervace

model Booking {
  id        String   @id @default(cuid())
  matchId   String?
  clientId  String
  cleanerId String // CleanerProfile.id
  start     DateTime
  end       DateTime
  service   String
  address   String?
  note      String?
  /// cena celkem v haléřích (orientační, platí se mimo platformu)
  priceTotal Int?
  /// REQUESTED | CONFIRMED | DECLINED | COMPLETED | CANCELLED_BY_CLIENT | CANCELLED_BY_CLEANER | NO_SHOW
  status    String   @default("REQUESTED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([cleanerId, start])
  @@index([clientId, start])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String
  authorId  String
  targetId  String
  rating    Int // 1–5
  quality       Int?
  punctuality   Int?
  communication Int?
  comment   String?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target  User    @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([bookingId, authorId])
  @@index([targetId])
}

// -------------------------------------------------------------------- platby

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  /// CARD | BANK_TRANSFER
  type      String   @default("CARD")
  brand     String? // visa, mastercard…
  last4     String?
  expMonth  Int?
  expYear   Int?
  /// token od brány – v DB nikdy neukládáme číslo karty
  providerToken String
  provider  String   @default("mock")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  matchId   String?
  subscriptionId String?
  /// CONNECTION_FEE | SUBSCRIPTION | CLEANER_FEE
  purpose   String
  /// částka v haléřích včetně DPH
  amount    Int
  currency  String   @default("CZK")
  vatRate   Int      @default(21)
  /// PENDING | PAID | FAILED | REFUNDED
  status    String   @default("PENDING")
  provider  String   @default("mock")
  providerRef String?
  description String?
  paidAt    DateTime?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  /// CLIENT_BASIC | CLEANER_PRO
  plan      String
  /// částka za období v haléřích
  amount    Int
  /// ACTIVE | PAST_DUE | CANCELLED | TRIALING
  status    String   @default("ACTIVE")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  provider  String   @default("mock")
  providerRef String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
}

// ------------------------------------------------------- komunikace, notifikace

model Conversation {
  id        String   @id @default(cuid())
  matchId   String   @unique
  createdAt DateTime @default(now())

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  /// NEW_OFFER | OFFER_ACCEPTED | BOOKING_REQUESTED | BOOKING_CONFIRMED | REVIEW_RECEIVED | PAYMENT
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
