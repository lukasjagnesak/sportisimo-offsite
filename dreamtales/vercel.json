{
  "crons": [
    {
      "path": "/api/cron/send-stories",
      "schedule": "0 * * * *"
    }
  ],
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/api/webhooks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
