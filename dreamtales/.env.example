# DreamTales Environment Variables
# Copy to .env.local and fill in your values

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic (Claude AI) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_... (or sk_test_... for development)
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... (or pk_test_...)

# Price IDs from your Stripe dashboard
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_FAMILY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_FAMILY_ANNUAL_PRICE_ID=price_...

# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── App Config ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dreamtales.eu
CRON_SECRET=your-random-secret-for-cron-security

# ─── Optional: Image Generation (fal.ai or Together AI) ──────────────────────
# FAL_API_KEY=your-fal-ai-key
# TOGETHER_API_KEY=your-together-ai-key
